# ==============================================================================
# Two Friends Pizza - Environment Configuration Template
# DO NOT ADD REAL SECRETS HERE. Copy to .env.local for local overrides.
# ==============================================================================

# Application URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# WhatsApp Integration (Configured for future WhatsApp Order Flow)
NEXT_PUBLIC_WHATSAPP_NUMBER=+000000000000
NEXT_PUBLIC_WHATSAPP_ORDER_PREFIX=TWO_FRIENDS_ORDER_

# Google Maps / Location Integration
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=YOUR_GOOGLE_MAPS_API_KEY_HERE
NEXT_PUBLIC_STORE_LATITUDE=0.000000
NEXT_PUBLIC_STORE_LONGITUDE=0.000000

# Analytics & Monitoring (Optional)
NEXT_PUBLIC_ANALYTICS_ID=YOUR_ANALYTICS_ID_HERE
